# name: test/sql/jev_no_key.test
# description: with no key configured, nothing is sent
# group: [sql]

#
# Only holds when TYPESAFE_API_KEY is absent from the environment, which is the only place a
# key can come from. scripts/run_tests_with_mock.sh runs it that way and sets this flag; a bare
# `make test` skips this file rather than spending a developer's key on it.

require snx_jev

require-env JEV_ASSERT_NO_API_KEY

statement error
SELECT jev({'name': 'Ada'}, 'the name is European');
----
no API key
