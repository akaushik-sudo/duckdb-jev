# name: test/sql/jev_no_key.test
# description: with no key configured, nothing is sent
# group: [sql]

#
# Split out of jev_offline.test because it only holds when TYPESAFE_API_KEY is absent
# from the environment. scripts/run_tests_with_mock.sh drops it and sets this flag;
# a bare `make test` skips this file rather than spending a developer's key on it.

require snx_jev

require-env JEV_ASSERT_NO_API_KEY

statement ok
SET jev_api_key = '';

statement error
SELECT jev({'name': 'Ada'}, 'the name is European');
----
no API key
