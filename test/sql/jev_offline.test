# name: test/sql/jev_offline.test
# description: everything that can be checked without reaching the API, in any environment
# group: [sql]

statement error
SELECT jev_version();
----
Catalog Error

require snx_jev

# jev_stats() hands back JSON, which the assertions below read
require json

query I
SELECT jev_version();
----
0.2.0

# The settings are registered with their documented defaults
query I
SELECT current_setting('snx_jev_model');
----
jev-latest

query I
SELECT current_setting('snx_jev_batch_size');
----
25

statement ok
SET snx_jev_batch_size = 40;

query I
SELECT current_setting('snx_jev_batch_size');
----
40

statement ok
RESET snx_jev_batch_size;

query I
SELECT current_setting('snx_jev_max_wait_seconds');
----
600

# The endpoint and the key are not settings: SQL can neither point requests elsewhere
# nor read the key back.
statement error
SET snx_jev_api_url = 'https://evil.example/v1/systemone';
----
unrecognized configuration parameter

statement error
SET jev_api_url = 'https://evil.example/v1/systemone';
----
unrecognized configuration parameter

statement error
SET jev_api_key = 'sk-anything';
----
unrecognized configuration parameter

statement error
SELECT current_setting('jev_api_key');
----
unrecognized configuration parameter

statement error
SET snx_jev_max_requests_per_minute = 0;
----
unrecognized configuration parameter

query I
SELECT count(*) FROM duckdb_settings()
WHERE name ILIKE '%jev%' AND (name ILIKE '%key%' OR name ILIKE '%url%' OR name ILIKE '%host%');
----
0

# A NULL row and a NULL condition are answered without asking anyone
query I
SELECT jev(NULL, 'the row is interesting');
----
NULL

query I
SELECT jev({'name': 'Ada'}, NULL);
----
NULL

# A question kind that does not exist is rejected before anything is sent
statement error
SELECT jev_eval({'name': 'Ada'}, 'how European?', 'rubric', ['a', 'b']);
----
unknown question kind

# score and choice need their options
statement error
SELECT jev_eval({'name': 'Ada'}, 'which team?', 'choice');
----
needs its options

statement error
SELECT jev_choice({'name': 'Ada'}, 'which team?', []);
----
at least one option

# NULL options are a NULL answer, the way DuckDB propagates NULLs everywhere else
query I
SELECT jev_choice({'name': 'Ada'}, 'which team?', NULL);
----
NULL

# The cache and the counters are reachable from SQL
query I
SELECT jev_cache_clear();
----
true

query I
SELECT json_extract_string(jev_stats(), '$.cached_answers')::BIGINT;
----
0
