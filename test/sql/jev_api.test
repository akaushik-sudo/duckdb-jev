# name: test/sql/jev_api.test
# description: the judgment functions against the deterministic mock (test/mock_api.py)
# group: [sql]

require snx_jev

require json

# scripts/run_tests_with_mock.sh starts the extension with SNX_JEV_API_URL pointing at the
# mock and TYPESAFE_API_KEY set to the mock's key; SQL can set neither.
require-env JEV_MOCK_API_URL

require-env SNX_JEV_API_URL

statement ok
CREATE TABLE people (id INTEGER, name VARCHAR, note VARCHAR);

statement ok
INSERT INTO people VALUES (1, 'Ada', 'writes compilers'), (2, 'Bo', 'sells shoes'), (3, 'Cy', 'writes poetry');

statement ok
SELECT jev_cache_clear();

# The mock answers 0.9 when the last word of the condition occurs in the row
query II
SELECT id, jev_prob(people, 'the person writes compilers') FROM people ORDER BY id;
----
1	0.9
2	0.1
3	0.1

# jev() is that probability against the threshold
query I
SELECT id FROM people WHERE jev(people, 'the person writes compilers') ORDER BY id;
----
1

# The threshold argument beats the setting, and the setting beats 0.5
query I
SELECT count(*) FROM people WHERE jev(people, 'the person writes compilers', 0.95);
----
0

statement ok
SET snx_jev_threshold = 0.05;

query I
SELECT count(*) FROM people WHERE jev(people, 'the person writes compilers');
----
3

statement ok
RESET snx_jev_threshold;

# An alias works the same way, and so does a subset of the columns
query I
SELECT count(*) FROM people p WHERE jev(p, 'the person writes compilers');
----
1

query I
SELECT count(*) FROM (SELECT name FROM people) n WHERE jev(n, 'the person is Ada');
----
1

# A scalar column, not only a whole row
query I
SELECT count(*) FROM people WHERE jev(name, 'the name is Ada');
----
1

# choice returns one of the options, verbatim
query I
SELECT bool_and(jev_choice(people, 'which team should handle this?', ['billing', 'technical', 'sales'])
                IN ('billing', 'technical', 'sales')) FROM people;
----
true

# score lands on the levels, score_norm on 0..1
query I
SELECT bool_and(jev_score(people, 'how senior is this person?', ['junior', 'mid', 'senior']) BETWEEN 0 AND 2)
FROM people;
----
true

query I
SELECT bool_and(jev_score_norm(people, 'how senior is this person?', ['junior', 'mid', 'senior']) BETWEEN 0 AND 1)
FROM people;
----
true

# The same (question, kind, options) is one call, so confidence is free after choice
query I
SELECT bool_and(jev_confidence(people, 'which team should handle this?', 'choice',
                               ['billing', 'technical', 'sales']) = 1.0) FROM people;
----
true

# jev_eval hands back the whole answer
query II
SELECT jev_eval(people, 'the person writes compilers')->>'type',
       (jev_eval(people, 'the person writes compilers')->>'noul')::DOUBLE
FROM people WHERE id = 1;
----
noul	0.9

query I
SELECT jev_eval(people, 'how senior is this person?', 'score', ['junior', 'mid', 'senior'])->>'legend' IS NOT NULL
FROM people WHERE id = 1;
----
true

# Answers are cached by row content: the second run asks nobody
statement ok
SELECT jev_cache_clear();

statement ok
CREATE TABLE counters AS SELECT 0 AS phase, jev_stats() AS stats;

statement ok
SELECT jev_prob(people, 'the person writes compilers') FROM people;

statement ok
INSERT INTO counters SELECT 1, jev_stats();

statement ok
SELECT jev_prob(people, 'the person writes compilers') FROM people;

statement ok
INSERT INTO counters SELECT 2, jev_stats();

# three rows judged in the first run, none in the second
query I
SELECT (MAX(CASE WHEN phase = 2 THEN json_extract_string(stats, '$.rows_evaluated')::BIGINT END) -
        MAX(CASE WHEN phase = 1 THEN json_extract_string(stats, '$.rows_evaluated')::BIGINT END))
FROM counters;
----
0

query I
SELECT (MAX(CASE WHEN phase = 1 THEN json_extract_string(stats, '$.rows_evaluated')::BIGINT END) -
        MAX(CASE WHEN phase = 0 THEN json_extract_string(stats, '$.rows_evaluated')::BIGINT END))
FROM counters;
----
3

# snx_jev_batch_size decides how many rows share a request
statement ok
SELECT jev_cache_clear();

statement ok
SET snx_jev_batch_size = 1;

statement ok
DELETE FROM counters;

statement ok
INSERT INTO counters SELECT 0, jev_stats();

statement ok
SELECT jev_prob(people, 'the person sells shoes') FROM people;

statement ok
INSERT INTO counters SELECT 1, jev_stats();

query I
SELECT (MAX(CASE WHEN phase = 1 THEN json_extract_string(stats, '$.requests')::BIGINT END) -
        MAX(CASE WHEN phase = 0 THEN json_extract_string(stats, '$.requests')::BIGINT END))
FROM counters;
----
3

statement ok
SET snx_jev_batch_size = 20;

statement ok
SELECT jev_cache_clear();

statement ok
DELETE FROM counters;

statement ok
INSERT INTO counters SELECT 0, jev_stats();

statement ok
SELECT jev_prob(people, 'the person sells shoes') FROM people;

statement ok
INSERT INTO counters SELECT 1, jev_stats();

query I
SELECT (MAX(CASE WHEN phase = 1 THEN json_extract_string(stats, '$.requests')::BIGINT END) -
        MAX(CASE WHEN phase = 0 THEN json_extract_string(stats, '$.requests')::BIGINT END))
FROM counters;
----
1

# A rejected request is reported, not retried into the ground
statement error
SELECT jev(people, 'this one says trigger422') FROM people;
----
API error 422

# A per-row condition is two questions in one chunk. When one of them fails the query
# fails, but the answers that did come back are kept, so the retry pays only for the rest.
statement ok
SELECT jev_cache_clear();

statement error
SELECT jev(people, CASE WHEN id = 1 THEN 'this one says trigger422' ELSE 'the person writes compilers' END)
FROM people;
----
API error 422

statement ok
DELETE FROM counters;

statement ok
INSERT INTO counters SELECT 0, jev_stats();

query I
SELECT count(*) FROM people WHERE jev(people, 'the person writes compilers');
----
1

statement ok
INSERT INTO counters SELECT 1, jev_stats();

query I
SELECT (MAX(CASE WHEN phase = 1 THEN json_extract_string(stats, '$.rows_evaluated')::BIGINT END) -
        MAX(CASE WHEN phase = 0 THEN json_extract_string(stats, '$.rows_evaluated')::BIGINT END))
FROM counters;
----
1

statement ok
SET snx_jev_max_retries = 2;

statement error
SELECT jev(people, 'this one says trigger503') FROM people;
----
unreachable after

statement ok
RESET snx_jev_max_retries;

# The cache is split by the connection's scope_customer_id (set by the search service from
# the verified token): one customer's answers are never another customer's cache hit.
statement ok
SELECT jev_cache_clear();

statement ok
SET VARIABLE scope_customer_id = 101;

statement ok
DELETE FROM counters;

statement ok
INSERT INTO counters SELECT 0, jev_stats();

statement ok
SELECT jev_prob(people, 'the person writes poetry') FROM people;

statement ok
INSERT INTO counters SELECT 1, jev_stats();

# the same customer again: all three from cache
statement ok
SELECT jev_prob(people, 'the person writes poetry') FROM people;

statement ok
INSERT INTO counters SELECT 2, jev_stats();

statement ok
SET VARIABLE scope_customer_id = 202;

# another customer, the same rows and question: asked again, not answered from 101's cache
statement ok
SELECT jev_prob(people, 'the person writes poetry') FROM people;

statement ok
INSERT INTO counters SELECT 3, jev_stats();

statement ok
RESET VARIABLE scope_customer_id;

# no scope at all (a hand-run session) is a namespace of its own
statement ok
SELECT jev_prob(people, 'the person writes poetry') FROM people;

statement ok
INSERT INTO counters SELECT 4, jev_stats();

query IIII
SELECT d1, d2, d3, d4 FROM (
  SELECT
    MAX(CASE WHEN phase = 1 THEN r END) - MAX(CASE WHEN phase = 0 THEN r END) AS d1,
    MAX(CASE WHEN phase = 2 THEN r END) - MAX(CASE WHEN phase = 1 THEN r END) AS d2,
    MAX(CASE WHEN phase = 3 THEN r END) - MAX(CASE WHEN phase = 2 THEN r END) AS d3,
    MAX(CASE WHEN phase = 4 THEN r END) - MAX(CASE WHEN phase = 3 THEN r END) AS d4
  FROM (SELECT phase, json_extract_string(stats, '$.rows_evaluated')::BIGINT AS r FROM counters)
);
----
3	0	3	3
