# name: test/sql/jev_unreachable.test
# description: the spend guard, and an endpoint that does not answer
# group: [sql]

#
# Run by scripts/run_tests_with_mock.sh with TYPESAFE_API_KEY set and SNX_JEV_API_URL pointing
# at a loopback port nothing listens on, so nothing here can reach a real endpoint.

require snx_jev

require-env JEV_ASSERT_UNREACHABLE

require-env SNX_JEV_API_URL

# The spend guard stops the statement before the request goes out
statement ok
SET snx_jev_max_rows_per_statement = 1;

statement error
SELECT jev(people, 'anything') FROM (VALUES (1), (2), (3)) people(id);
----
snx_jev_max_rows_per_statement

statement ok
RESET snx_jev_max_rows_per_statement;

# An unreachable endpoint fails with the endpoint's error, not with a wrong answer
statement ok
SET snx_jev_max_retries = 1;

statement error
SELECT jev({'name': 'Ada'}, 'the name is European');
----
unreachable
