# name: test/sql/jev_concurrency.test
# description: queries that meet the same uncached prompt at once send it once (single-flight)
# group: [sql]

#
# Against the mock, with SNX_JEV_ENABLE_GENERIC=1 (for jev_stats). A row containing "slowmock"
# makes the mock take 3 s, so the concurrent queries overlap.

require snx_jev

require json

require-env JEV_MOCK_API_URL

require-env SNX_JEV_API_URL

statement ok
SELECT jev_cache_clear();

statement ok
CREATE TABLE counters AS SELECT 0 AS phase, jev_stats() AS stats;

concurrentloop i 0 4

statement ok
SELECT jev_prob(x, 'the text says hello') FROM (VALUES ('slowmock hello')) t(x);

endloop

statement ok
INSERT INTO counters SELECT 1, jev_stats();

# four queries, one request; the other three took its answer (or, if they started late, the cache)
query II
SELECT MAX(CASE WHEN phase = 1 THEN (stats->>'requests')::BIGINT END) -
       MAX(CASE WHEN phase = 0 THEN (stats->>'requests')::BIGINT END),
       (MAX(CASE WHEN phase = 1 THEN (stats->>'shared_in_flight')::BIGINT + (stats->>'cache_hits')::BIGINT END) -
        MAX(CASE WHEN phase = 0 THEN (stats->>'shared_in_flight')::BIGINT + (stats->>'cache_hits')::BIGINT END))
FROM counters;
----
1	3

# and at least one of them really waited on the request in flight
query I
SELECT MAX(CASE WHEN phase = 1 THEN (stats->>'shared_in_flight')::BIGINT END) -
       MAX(CASE WHEN phase = 0 THEN (stats->>'shared_in_flight')::BIGINT END) >= 1
FROM counters;
----
true

#
# A query whose own batch fails does not take the others down with it: a query that was
# waiting on its row claims the row and sends it itself.
#
# Iteration 0 sends the shared row in a batch with a "fail422" row (the mock fails that whole
# batch after 3 s); iteration 1 asks only for the shared row. Whichever claims first, 0 fails
# and 1 gets its answer.

statement ok
SELECT jev_cache_clear();

concurrentloop i 0 2

statement maybe
SELECT jev_prob(x, 'the text is shared') FROM (VALUES ('slowmock shared row'), (CASE WHEN ${i} = 0 THEN 'fail422 row' END)) t(x);
----
API error 422

endloop

statement ok
DELETE FROM counters;

statement ok
INSERT INTO counters SELECT 0, jev_stats();

# the shared row was answered (by iteration 1) and cached: asking again sends nothing
query I
SELECT jev_prob(x, 'the text is shared') FROM (VALUES ('slowmock shared row')) t(x);
----
0.9

statement ok
INSERT INTO counters SELECT 1, jev_stats();

query I
SELECT MAX(CASE WHEN phase = 1 THEN (stats->>'requests')::BIGINT END) -
       MAX(CASE WHEN phase = 0 THEN (stats->>'requests')::BIGINT END)
FROM counters;
----
0
